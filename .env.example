# Local Postgres, or a Neon connection string when you deploy.
DATABASE_URL=postgres://navi:navi_local_dev@127.0.0.1:5432/navi

# Sent as Authorization: Bearer <CRON_SECRET> by Vercel Cron and by curl.
# The on-site «Оновити» button calls the same sync on the server and does not expose this value.
CRON_SECRET=replace-with-a-long-random-string

# Primary match provider: bo3 (default, includes player stats) or liquipedia.
# MATCH_SOURCE=bo3

# Optional FREE public JSON odds feed (no paid subscription). Leave empty when unavailable.
# Array: [{matchId,bookmaker,url,at,team,opponent}]; decimal prices, team is the tracked side.
# ODDS_PUBLIC_FEED_URL=

# Optional independent match verification. Server-side only.
# Without a token, the UI explicitly labels matches as single-source.
# PANDASCORE_TOKEN=

# Optional AI selection/order of sourced facts, cached until the input changes.
# Configure BOTH values to activate AI. Without them, a factual digest still works.
# OPENAI_MODEL must be a model available to your API project with Responses + Structured Outputs.
# OPENAI_API_KEY=
# OPENAI_MODEL=
