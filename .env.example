# Local Postgres, or a Neon connection string when you deploy.
DATABASE_URL=postgres://navi:navi_local_dev@127.0.0.1:5432/navi

# Sent as Authorization: Bearer <CRON_SECRET> by Vercel Cron and by curl.
# The on-site «Оновити» button calls the same sync on the server and does not expose this value.
CRON_SECRET=replace-with-a-long-random-string

# Optional. A model key is not required. Tone is a lexicon (спокійно / зібрано / напружено).
# If you add a key later, use it inside the sync to write a short summary once — not on every page view.
# OPENAI_API_KEY=
